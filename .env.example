# Vertex AI Gemini configuration. Authentication uses local Application Default Credentials:
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=project-f55f38c5-47dc-49c1-8f3
GOOGLE_CLOUD_LOCATION=global
AI_MODEL=gemini-3.1-pro-preview

# Python executable containing the pinned google-genai dependency.
PYTHON_BIN=python
AI_MAX_TOKENS=16000
# Per-provider-request and end-to-end generation deadlines (milliseconds).
AI_TIMEOUT_MS=120000
AI_OPERATION_TIMEOUT_MS=360000

# Python 2D-editor AI layout generator (generate_layout/ai_client.py). Gemini 3.1 Pro
# Preview uses HIGH thinking, which shares the output-token budget; keep this high so the
# spec/furniture JSON is not truncated. Max 65536. AI_LAYOUT_THINKING_BUDGET applies only
# to a 2.5 override.
AI_LAYOUT_MODEL=gemini-3.1-pro-preview
AI_LAYOUT_MAX_TOKENS=32000
AI_LAYOUT_THINKING_BUDGET=6144
AI_LAYOUT_TIMEOUT_MS=120000
AI_LAYOUT_OPERATION_TIMEOUT_MS=300000

# Layout planner rollout. "comb" (default/fallback) is the deterministic single-topology
# engine. "multi" builds the comb shell, then explores diverse topologies (feasibility ->
# candidates -> scoring -> diversity) and applies the best; comb is retained as a candidate.
# An unknown value fails closed. AI_LAYOUT_SEED keeps planner selection reproducible.
AI_LAYOUT_PLANNER=comb
AI_LAYOUT_SEED=0

HOST=127.0.0.1
PORT=3000

# Optional exact additional browser origin; same-origin and local-to-local dev are allowed automatically.
APP_ORIGIN=http://127.0.0.1:5173
