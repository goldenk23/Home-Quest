# Vertex AI Gemini configuration. Authentication uses local Application Default Credentials:
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=project-f55f38c5-47dc-49c1-8f3
GOOGLE_CLOUD_LOCATION=us-central1
AI_MODEL=gemini-2.5-pro

# Python executable containing the pinned google-genai dependency.
PYTHON_BIN=python
AI_MAX_TOKENS=16000
# Per-provider-request and end-to-end generation deadlines (milliseconds).
AI_TIMEOUT_MS=120000
AI_OPERATION_TIMEOUT_MS=360000

# Python 2D-editor AI layout generator (generate_layout/ai_client.py). Defaults favor
# accuracy; set AI_LAYOUT_MODEL=gemini-2.5-flash and lower the thinking budget for speed.
AI_LAYOUT_MODEL=gemini-2.5-pro
AI_LAYOUT_MAX_TOKENS=16000
AI_LAYOUT_THINKING_BUDGET=6144
AI_LAYOUT_TIMEOUT_MS=120000
AI_LAYOUT_OPERATION_TIMEOUT_MS=300000

HOST=127.0.0.1
PORT=3000

# Optional exact additional browser origin; same-origin and local-to-local dev are allowed automatically.
APP_ORIGIN=http://127.0.0.1:5173
