# Vertex AI configuration used by the Python/Tkinter layout generator.
# Authenticate locally with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
AI_LAYOUT_MODEL=gemini-3.1-pro-preview

# Gemini 3 uses a thinking level; Gemini 2.5 overrides use the numeric budget.
AI_LAYOUT_THINKING_LEVEL=HIGH
AI_LAYOUT_THINKING_BUDGET=6144
AI_LAYOUT_MAX_TOKENS=32000
AI_LAYOUT_TIMEOUT_MS=120000
AI_LAYOUT_OPERATION_TIMEOUT_MS=300000

# Deterministic layout planner rollout.
AI_LAYOUT_PLANNER=comb
AI_LAYOUT_SEED=0
